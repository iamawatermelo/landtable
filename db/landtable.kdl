type "workspace"
version 1

alias "High Seas"
alias "hs"
id "ltb:XXXX"

// Whether to allow the API to modify this workspace
allow_runtime_modification false

// Instructions on how to create this table from scratch.
// We can use existing strategies defined at the meta level:
primary_strategy extends="Nest Postgres" table_name="people"
secondary_strategy "airtable" extends="HC Airtable" base="appXXXX"

// or write completely new strategies:
/-primary_strategy {
    using "postgres_provisioning_plugin"
    hostname "hackclub.app"
    table_name "people"
    
    authentication "userpass" {
        username "sarah"
        password "i_l0ve_hC!"
    }
}

/-secondary_strategy "airtable" {
    using "airtable_provisioning_plugin"
    base "appXXXX"
    
    authentication "token" {
        token "patXXXX"
    }
}

table "people" {
    // specify values as attributes...
    field "first_name" type="short_text"
    
    // ... or nested nodes
    field "last_name" {
        type "short_text"
        
        // change the column on the primary replica
        primary_config {
            column "name"
        }
        
        // or the secondary replica
        secondary_config "airtable" {
            // let's not replicate PII to Airtable!
            disallow_replication true
        }
    }
    
    // Computed fields!
    field "name" {
        type "formula"
        formula "{first_name} & \" \" & {last_name}"
    }
    
    field "email" type="email"
    
    // you can use nested nodes _and_ attributes even
    field "frumbicated_status" type="enum" {
        default "florp"
        
        enum "florp"
        enum "glorp"
        enum "gloop"
        enum "gleep"
    }
    
    // Landtable formulae can be saved in views!
    view "floorped_people" filter="{frumbicated_status} = \"florp\""
}